      "description": "Bordered control for recovery and pagination.",
      "html": "<button class=\"ds-secondary\">Load more \u2193</button>",
      "css": ".ds-secondary{font:500 12px/1.55 var(--sans);min-height:36px;padding:8px 13px;border-radius:6px;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out;background:var(--surface);color:var(--ink);border:1px solid #d8deea}.ds-secondary:hover{background:#f1f4fb;border-color:#b5c0d9}.ds-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Session search",
      "kind": "input",
      "refersTo": "search-field",
      "description": "A compact search field with a single enclosing focus treatment.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 4.5 4.5\"/></svg><input aria-label=\"Search this session\" placeholder=\"Search this session\u2026\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;padding:0 10px;min-height:36px;border:1px solid #dce1eb;border-radius:5px;background:var(--surface);color:#738099}.ds-search:focus-within{border-color:var(--accent);outline:2px solid #dce4ff}.ds-search input{font:12px/1.55 var(--sans);min-width:0;width:100%;padding:8px 0;border:0;background:transparent;color:var(--ink)}.ds-search input:focus-visible{outline:0}.ds-search input::placeholder{color:#717e96}"
    },
    {
      "name": "Primary navigation",
      "kind": "nav",
      "refersTo": "nav-selected",
      "description": "The cobalt current route sits on the ink navigation field.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button>Overview</button><button aria-current=\"page\">Sessions</button></nav>",
      "css": ".ds-nav{background:var(--sidebar);padding:14px;display:grid;gap:4px}.ds-nav button{font:400 13px/1.55 var(--sans);text-align:left;padding:10px 12px;min-height:42px;border:0;border-radius:6px;background:transparent;color:#bdc7da;cursor:pointer}.ds-nav button:hover{background:#242e46;color:#fff}.ds-nav button[aria-current]{background:#324ec0;color:#fff}.ds-nav button:focus-visible{outline:2px solid #b7c7ff;outline-offset:3px}"
    },
    {
      "name": "Observation filter",
      "kind": "chip",
      "refersTo": "filter-selected",
      "description": "Selection uses an explicit pressed state as well as the cobalt wash.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">All activity</button>",
      "css": ".ds-filter{font:550 10px/1.55 var(--sans);padding:5px 8px;min-height:28px;border:1px solid #dae2ff;border-radius:4px;color:var(--accent);background:var(--selected);cursor:pointer}.ds-filter:hover{background:#f4f6fc}.ds-filter:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    },
    {
      "name": "Ruled register",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white working region with aligned ruled rows.",
      "html": "<section class=\"ds-register\"><h2>Recent sessions</h2><button>Handle an empty cache response <span>End recorded \u2192</span></button></section>",
      "css": ".ds-register{font:13px/1.55 var(--sans);background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:8px;overflow:hidden}.ds-register h2{font-size:14px;font-weight:550;margin:0;padding:17px 20px}.ds-register button{display:flex;justify-content:space-between;gap:20px;text-align:left;width:100%;min-height:106px;padding:18px 20px;border:0;border-top:1px solid var(--line-soft);background:transparent;color:inherit;font:550 13px/1.55 var(--sans);cursor:pointer}.ds-register button span{font-size:10px;font-weight:400;color:var(--muted)}.ds-register button:hover{background:#f6f8ff}.ds-register button:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}"
    },
    {
      "name": "Evidence basis",
      "kind": "custom",
      "refersTo": "evidence-recorded",
      "description": "Recorded and derived states stay textually explicit.",
      "html": "<div class=\"ds-bases\"><span>Recorded observation</span><span class=\"ds-derived\">Derived \u00b7 explicit ID match</span></div>",
      "css": ".ds-bases{display:flex;flex-wrap:wrap;gap:8px}.ds-bases span{font:400 9px/1.55 var(--sans);padding:2px 6px;border:1px solid #dce4f8;border-radius:4px;background:#f0f4ff;color:#4965a4}.ds-bases .ds-derived{border-color:#e2d8f6;background:#f7f2ff;color:#7257a6}"
    },
    {
      "name": "Captured code diff",
      "kind": "custom",
      "refersTo": "captured-diff",
      "description": "Inert before/after code with explicit signs, line numbers, and semantic gutters.",
      "html": "<section class=\"ds-diff\" tabindex=\"0\" aria-label=\"Unified code diff\"><table><thead><tr><th>Before</th><th>After</th><th>Change</th><th>Captured code</th></tr></thead><tbody><tr class=\"ds-delete\"><td>2</td><td></td><td>\u2212</td><td><code>return count.toString();</code></td></tr><tr class=\"ds-add\"><td></td><td>2</td><td>+</td><td><code>return count ?? null;</code></td></tr></tbody></table></section>",
      "css": ".ds-diff{overflow:auto;max-height:65vh;border:1px solid var(--line);border-radius:7px;background:var(--surface)}.ds-diff:focus-visible{outline:2px solid var(--accent);outline-offset:-3px}.ds-diff table{border-collapse:collapse;min-width:100%;font:11px/1.85 var(--mono)}.ds-diff th{position:sticky;top:0;background:#f3f5fa;padding:7px 9px;text-align:left;font:450 9px/1.6 var(--sans);color:var(--muted)}.ds-diff td{padding:1px 9px;white-space:pre;color:#3b4b69}.ds-diff td:nth-child(-n+2){font-size:10px;text-align:right;min-width:38px;color:var(--muted);background:#f9fafe;border-right:1px solid #e9edf6}.ds-diff code{font:inherit}.ds-diff .ds-add{background:#eff9f3}.ds-diff .ds-delete{background:#fff1f3}.ds-diff .ds-add td:nth-child(-n+2){color:#307354;background:#e5f3eb}.ds-diff .ds-delete td:nth-child(-n+2){color:#924354;background:#fbe4e9}.ds-diff .ds-add td:nth-child(3){color:#307354}.ds-diff .ds-delete td:nth-child(3){color:var(--negative)}@media(max-width:559px){.ds-diff table{font-size:10px}.ds-diff td:nth-child(-n+2){min-width:30px;padding-inline:6px}}"
    },
    {
      "name": "Diff layout control",
      "kind": "button",
      "refersTo": "diff-mode-selected",
      "description": "Explicit pressed state for unified and side-by-side inspection.",
      "html": "<fieldset class=\"ds-diff-mode\"><legend>Code diff layout</legend><button aria-pressed=\"true\">Unified</button><button aria-pressed=\"false\">Side by side</button></fieldset>",
      "css": ".ds-diff-mode{display:flex;gap:2px;margin:0;padding:2px;background:#fafbfe;border:1px solid #dce2ee;border-radius:5px}.ds-diff-mode legend{font:10px var(--sans);color:var(--muted)}.ds-diff-mode button{font:10px/1.55 var(--sans);min-height:26px;padding:4px 9px;border:0;border-radius:3px;background:transparent;color:var(--muted);cursor:pointer}.ds-diff-mode button:hover{background:#edf1fa}.ds-diff-mode button[aria-pressed=\"true\"]{background:var(--surface);color:var(--accent);box-shadow:0 1px 3px #20345e14}.ds-diff-mode button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Municipal wayfinding",
    "overview": "Traceframe uses a stable ink navigation edge, a cool-white working field, compact Geist labels, and ruled registers to orient a developer before they inspect evidence. The committed direction is candidate 7, seed `2f68dc64`, recorded in the root layout. Cobalt marks selection and action; it does not certify an outcome.\n\nThe atmosphere is orderly, practical, and quietly precise. Desktop review pairs an activity register with a source inspector. Narrow screens preserve that relationship through a native evidence dialog. Explicit labels distinguish recorded observations, derived links, source-reported results, and capture uncertainty.",
    "keyCharacteristics": [
      "Ink navigation and a porcelain workspace.",
      "Ruled, aligned registers with compact outline icons.",
      "Cobalt selection; semantic source-state labels.",
      "Paired activity and evidence, with provenance disclosed on demand."
    ],
    "rules": [
      {
        "name": "The Evidence State Rule",
        "body": "Pair every semantic color with wording, an icon, a number, or a source-state label. A successful exit code never becomes a feature-correctness verdict.",
        "section": "colors"
      },
      {
        "name": "The Source Readability Rule",
        "body": "Keep ordinary labels in Geist and captured commands, IDs, paths, and payloads in monospace. Keep provenance subordinate to the captured content without removing it.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use cobalt for routes, actions, and selection, and explicit semantic labels for evidence states.",
      "**Do** keep activity and source inspection adjacent on desktop and use the native evidence dialog on narrower screens.",
      "**Do** preserve fine register rules, aligned counts, compact Geist labels, and monospace source material.",
      "**Do** show unknowns and capture limitations where the reader interprets the evidence.",
      "**Do** preserve keyboard focus, native controls, responsive reflow, and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** restore the superseded olive-green identity or make semantic result green the primary accent.",
      "**Don't** use color alone to distinguish recorded, derived, failed, or incomplete evidence.",
      "**Don't** turn command success, an end event, or an explicit ID link into a correctness claim.",
      "**Don't** present synthetic examples as live ingestion, referenced paths as captured diffs, or relationship routes as a graph feature.",
      "**Don't** add resting shadows or ornamental animation to the working registers."
    ]
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:site",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/landing/",
      "permanent": false,
      "missing": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ]
    },
    {
      "source": "/class",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/class/",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/class/:path*",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "https://app.iceq.best/",
      "permanent": true,
      "missing": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ]
    },
    {
      "source": "/studio/:path*",
      "destination": "https://app.iceq.best/:path*",
      "permanent": true,
      "missing": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/studio/:path*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ],
      "destination": "/studio/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ],
      "destination": "/studio/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.iceq.best"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-HTIyDH0E/1bOIJ8x8OStFcT8z/hdqXO2owTRoyl9Wuw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}

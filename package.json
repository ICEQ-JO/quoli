{
  "name": "quoli",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx server/main.ts",
    "demo": "node --import tsx server/main.ts --demo",
    "start": "vite build && NODE_ENV=production node --import tsx server/main.ts",
    "connect": "node --import tsx server/connect.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test tests/*.test.ts",
    "landing": "node --import tsx server/main.ts --landing"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@xyflow/react": "12.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "axe-core": "4.11.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.1.12"
  }
}

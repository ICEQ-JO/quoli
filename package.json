{
  "name": "quoli",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.3.4",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx server/main.ts",
    "demo": "node --import tsx server/main.ts --demo",
    "start": "vite build && NODE_ENV=production node --import tsx server/main.ts",
    "connect": "node --import tsx server/connect.ts",
    "quoli-setup": "node --import tsx server/setup.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --import ./tests/isolate.ts --test tests/*.test.ts",
    "landing": "node --import tsx server/main.ts --landing",
    "pack:release": "node scripts/pack.mjs",
    "build:site": "node scripts/pack.mjs && npm pack ./release --pack-destination release && QUOLI_BUILD=landing vite build && cp release/iceq-quoli-$npm_package_version.tgz dist/quoli-$npm_package_version.tgz && cp dist/quoli-$npm_package_version.tgz dist/quoli.tgz && cp release/quoli.json dist/quoli.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@xyflow/react": "12.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "axe-core": "4.11.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.1.12"
  }
}
